      { "tick": 2, "easing": "OUTCUBIC", "rightArm": { "pitch": 45.0, "yaw": -10.0, "roll": -12.0 } },
      { "tick": 10, "easing": "INOUTSINE", "rightArm": { "pitch": 0.0, "yaw": 0.0, "roll": 0.0 } },
      { "tick": 0, "easing": "OUTCUBIC", "leftArm": { "pitch": 0.0, "yaw": 0.0, "roll": 0.0 } },
      { "tick": 2, "easing": "OUTCUBIC", "leftArm": { "pitch": 45.0, "yaw": 10.0, "roll": 12.0 } },
      { "tick": 10, "easing": "INOUTSINE", "leftArm": { "pitch": 0.0, "yaw": 0.0, "roll": 0.0 } },
      { "tick": 0, "easing": "OUTCUBIC", "torso": { "pitch": 0.0 } },
      { "tick": 2, "easing": "OUTCUBIC", "torso": { "pitch": 18.0 } },
      { "tick": 10, "easing": "INOUTSINE", "torso": { "pitch": 0.0 } }
