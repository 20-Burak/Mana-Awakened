    "easeBeforeKeyframe": true,
    "moves": [
      { "tick": 0, "easing": "OUTCUBIC", "rightArm": { "pitch": 0.0, "yaw": 0.0, "roll": 0.0 } },
      { "tick": 1, "easing": "OUTCUBIC", "rightArm": { "pitch": -20.0, "yaw": 0.0, "roll": -25.0 } },
      { "tick": 7, "easing": "INOUTSINE", "rightArm": { "pitch": 0.0, "yaw": 0.0, "roll": 0.0 } },
      { "tick": 0, "easing": "OUTCUBIC", "leftArm": { "pitch": 0.0, "yaw": 0.0, "roll": 0.0 } },
      { "tick": 1, "easing": "OUTCUBIC", "leftArm": { "pitch": -20.0, "yaw": 0.0, "roll": 25.0 } },
      { "tick": 7, "easing": "INOUTSINE", "leftArm": { "pitch": 0.0, "yaw": 0.0, "roll": 0.0 } },
      { "tick": 0, "easing": "OUTCUBIC", "torso": { "pitch": 0.0 } },
      { "tick": 1, "easing": "OUTCUBIC", "torso": { "pitch": 10.0 } },
      { "tick": 7, "easing": "INOUTSINE", "torso": { "pitch": 0.0 } }
    ]
  }
